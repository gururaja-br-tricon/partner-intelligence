# Snowflake Creds
SNOWFLAKE_ACCOUNT=""
SNOWFLAKE_USER=""
SNOWFLAKE_PASSWORD=""
SNOWFLAKE_WAREHOUSE=""
SNOWFLAKE_DATABASE=""
SNOWFLAKE_SCHEMA=""

# PineCone Creds
PINECONE_API_KEY=""

# LLM provider: "groq" (default) or "qwen"
LLM_PROVIDER="groq"

# Groq (gpt-oss)
GROQ_BASE_URL=""
GROQ_API_KEY=""
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_EMBEDDING_MODEL="nomic-embed-text-v1.5"

# Qwen hosted in infra (OpenAI-compatible /v1)
QWEN_BASE_URL=""
QWEN_API_KEY=""
QWEN_CHAT_MODEL="qwen"
QWEN_EMBEDDING_MODEL="bge-m3"

# MCP server
MCP_URL="http://127.0.0.1:8000/mcp"

# Context layer
MEMORY_TURNS="6"
# RAG-only (disabled for POC — uncomment with RAG):
# CACHE_THRESHOLD="0.95"
# RAG_TOP_K="5"
# DOC_CHUNKS_TABLE="PARTNER_DOC_CHUNKS"